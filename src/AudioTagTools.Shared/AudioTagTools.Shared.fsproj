<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>false</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Constants.fs" />
        <Compile Include="Types.fs" />
        <Compile Include="TagLibrary.fs" />
        <Compile Include="Printing.fs" />
        <Compile Include="IO.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CCFSharpUtils" Version="0.6.0" />
      <PackageReference Include="FSharp.Data" Version="8.2.0" />
      <PackageReference Include="FSharpPlus" Version="1.9.1" />
      <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
      <PackageReference Update="FSharp.Core" Version="11.0.101" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
      <PackageReference Include="TagLibSharp" Version="2.3.0" />
    </ItemGroup>

</Project>
