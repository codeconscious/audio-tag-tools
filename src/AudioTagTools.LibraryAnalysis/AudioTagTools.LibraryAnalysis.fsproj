<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>false</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Errors.fs" />
        <Compile Include="Analysis.fs" />
        <Compile Include="ArgValidation.fs" />
        <Compile Include="Library.fs"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AudioTagTools.Shared\AudioTagTools.Shared.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="FSharp.Core" Version="11.0.101" />
      <PackageReference Include="FSharpPlus" Version="1.9.1" />
      <PackageReference Include="CCFSharpUtils" Version="0.6.0" />
    </ItemGroup>

</Project>
